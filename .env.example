# Copy to .env (never commit .env) or set these as variables on your host (e.g. Railway).
SHELFPRINT_SERVICE_TOKEN=change-me-to-a-long-random-string
SHELFPRINT_VISION_PROVIDER=anthropic            # stub | anthropic
# ANTHROPIC_API_KEY=                       # only when SHELFPRINT_VISION_PROVIDER=anthropic
# SHELFPRINT_VISION_MODEL=claude-sonnet-5-5
# SHELFPRINT_IMAGE_HOSTS=res.cloudinary.com

# Production: set these two on the Python service (Railway variables). Stub is refused when SHELFPRINT_ENV=production.
# SHELFPRINT_ENV=production
# SHELFPRINT_VISION_PROVIDER=anthropic
